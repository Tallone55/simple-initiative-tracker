<?xml version='1.0' encoding='UTF-8'?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <object class="GtkWindow" id="unsaved_window">
    <property name="modal">true</property>
    <property name="resizable">false</property>
    <property name="default-width">360</property>
    <property name="title">Unsaved Changes</property>
    <child>
      <object class="GtkBox" id="unsaved_box">
        <property name="orientation">vertical</property>
        <property name="spacing">12</property>
        <property name="margin-top">16</property>
        <property name="margin-bottom">16</property>
        <property name="margin-start">16</property>
        <property name="margin-end">16</property>
        <child>
          <object class="GtkLabel" id="message_label">
            <property name="label">You have unexported changes. Export before closing?</property>
            <property name="wrap">true</property>
            <property name="xalign">0</property>
          </object>
        </child>
        <child>
          <object class="GtkBox" id="button_box">
            <property name="orientation">horizontal</property>
            <property name="spacing">6</property>
            <property name="halign">end</property>
            <child>
              <object class="GtkButton" id="discard_button">
                <property name="label">Discard</property>
                <style>
                  <class name="destructive-action"/>
                </style>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="cancel_button">
                <property name="label">Cancel</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="export_button">
                <property name="label">Export</property>
                <property name="receives-default">true</property>
                <style>
                  <class name="suggested-action"/>
                </style>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
